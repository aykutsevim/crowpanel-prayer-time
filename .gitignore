# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# ESP-IDF (decision 0002): downloaded components and the expanded configuration are generated.
# Keep sdkconfig.defaults (the source) and dependencies.lock (exact versions and hashes).
managed_components/
sdkconfig.*
!sdkconfig.defaults

# Host UI harness output
out/

# Python
__pycache__/
*.pyc
.venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code machine-local settings
.claude/settings.local.json

# Secrets must never be committed (CLAUDE.md, SEC-04)
*.secret
secrets.ini
.env
# Factory flash backups may hold Wi-Fi details stored by the vendor firmware
backup/

# Generated from data/ by tools/gen_web.py before each firmware build (spec 004 R7)
src/generated/
